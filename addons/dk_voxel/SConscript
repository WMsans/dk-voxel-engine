# Shared source list for the dk_voxel addon, for games that compile it into their own GDExtension.
#
# From a game's SConstruct, after godot-cpp has set up `env`:
#
#     dk_sources, dk_include = SConscript("addons/dk_voxel/SConscript", {"env": env})
#     env.Append(CPPPATH=[dk_include])
#     env.SharedLibrary("bin/mygame", source=dk_sources + env.Glob("src/*.cpp"))
#
# `dk_sources` are the addon's .cpp files as SCons nodes in the addon's `build/obj` VariantDir: they
# compile with the game's `env` and flags, but their objects land next to the addon, not in the game's
# build tree. `dk_include` is the addon's `src/`, where the headers live (and where the game's
# `#include "register_types.h"` resolves). The addon's own GDExtension entry symbol is `src/entry.cpp`,
# which is deliberately left out: the game's library provides its own. The addon's own SConstruct adds it.
# The SConscript also appends `-O3` to the caller's `env`, so every source built with that `env` is
# affected, the game's own sources included. godot-cpp appends its `-O2`/`-O0` to `CCFLAGS`, which SCons
# puts after `CXXFLAGS` on the command line, so the effective level is godot-cpp's, not this one.
Import("env")

# The mesher is the hot path, so this appends -O3 even in a template_debug build. godot-cpp's own -O2/-O0
# goes on CCFLAGS, which SCons puts after CXXFLAGS, so the effective level is godot-cpp's; and because
# the flag lands on the caller's `env`, it also applies to the game's own sources, not only the addon's.
env.Append(CXXFLAGS=["-O3"])

here = Dir(".")
src = here.Dir("src")
obj = here.Dir("build/obj")
env.VariantDir(obj, src, duplicate=0)
sources = [obj.File(name) for name in (
	"core/voxel_mesher.cpp",
	"core/voxel_volume.cpp",
	"demo_generator.cpp",
	"register_types.cpp",
	"voxel_chunks.cpp",
	"voxel_resources.cpp",
	"voxel_save.cpp",
	"voxel_world.cpp",
)]
Return("sources", "src")
