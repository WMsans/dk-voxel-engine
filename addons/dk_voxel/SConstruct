#!/usr/bin/env python
"""Build the dk_voxel GDExtension and the host-side core self-test.

    scons platform=linux arch=x86_64 target=template_debug   # extension -> bin/
    scons selftest && build/selftest                           # core checks, no Godot
"""
import os

env = Environment()
env["ARCOM"] = "${TEMPFILE('$AR $ARFLAGS $TARGET $SOURCES')}"
SConscript(os.path.join("thirdparty", "godot-cpp", "SConstruct"), {"env": env, "customs": ["custom.py"], "api_version": "4.7"})

# The addon's sources, from the SConscript games share (it also appends the mesher's -O3). Only the
# addon's own library adds entry.cpp, the GDExtension entry symbol a game replaces with its own; it goes through the same object variant dir so
# its object does not land in src/.
dk_sources, dk_include = SConscript("SConscript", {"env": env})
env.Append(CPPPATH=[dk_include])
suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
Default(env.SharedLibrary("bin/libdk_voxel" + suffix + env["SHLIBSUFFIX"], source=dk_sources + [File("build/obj/entry.cpp")]))

# Core self-test: host toolchain only (volume/mesher have no Godot dependency).
t = Environment()
t.Append(CXXFLAGS=["-O2", "-g", "-std=c++17", "-pthread"], LINKFLAGS=["-pthread"])
t.VariantDir("build/test", "src", duplicate=0)
Alias("selftest", t.Program("build/selftest", source=["build/test/core/voxel_volume.cpp", "build/test/demo_terrain.cpp", "build/test/core/voxel_mesher.cpp", "build/test/selftest.cpp"]))
