[configuration]

entry_symbol = "dk_voxel_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://addons/dk_voxel/bin/libdk_voxel.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/dk_voxel/bin/libdk_voxel.linux.template_release.x86_64.so"
macos.debug.arm64 = "res://addons/dk_voxel/bin/libdk_voxel.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://addons/dk_voxel/bin/libdk_voxel.macos.template_release.arm64.dylib"
